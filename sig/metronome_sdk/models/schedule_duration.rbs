module MetronomeSDK
  module Models
    type schedule_duration =
      {
        schedule_items: ::Array[MetronomeSDK::ScheduleDuration::ScheduleItem],
        access_type: MetronomeSDK::Models::ScheduleDuration::access_type,
        credit_type: MetronomeSDK::CreditTypeData
      }

    class ScheduleDuration < MetronomeSDK::Internal::Type::BaseModel
      attr_accessor schedule_items: ::Array[MetronomeSDK::ScheduleDuration::ScheduleItem]

      attr_reader access_type: MetronomeSDK::Models::ScheduleDuration::access_type?

      def access_type=: (
        MetronomeSDK::Models::ScheduleDuration::access_type
      ) -> MetronomeSDK::Models::ScheduleDuration::access_type

      attr_reader credit_type: MetronomeSDK::CreditTypeData?

      def credit_type=: (
        MetronomeSDK::CreditTypeData
      ) -> MetronomeSDK::CreditTypeData

      def initialize: (
        schedule_items: ::Array[MetronomeSDK::ScheduleDuration::ScheduleItem],
        ?access_type: MetronomeSDK::Models::ScheduleDuration::access_type,
        ?credit_type: MetronomeSDK::CreditTypeData
      ) -> void

      def to_hash: -> {
        schedule_items: ::Array[MetronomeSDK::ScheduleDuration::ScheduleItem],
        access_type: MetronomeSDK::Models::ScheduleDuration::access_type,
        credit_type: MetronomeSDK::CreditTypeData
      }

      type schedule_item =
        { id: String, amount: Float, ending_before: Time, starting_at: Time }

      class ScheduleItem < MetronomeSDK::Internal::Type::BaseModel
        attr_accessor id: String

        attr_accessor amount: Float

        attr_accessor ending_before: Time

        attr_accessor starting_at: Time

        def initialize: (
          id: String,
          amount: Float,
          ending_before: Time,
          starting_at: Time
        ) -> void

        def to_hash: -> {
          id: String,
          amount: Float,
          ending_before: Time,
          starting_at: Time
        }
      end

      type access_type = :SPEND | :QUANTITY

      module AccessType
        extend MetronomeSDK::Internal::Type::Enum

        SPEND: :SPEND
        QUANTITY: :QUANTITY

        def self?.values: -> ::Array[MetronomeSDK::Models::ScheduleDuration::access_type]
      end
    end
  end
end
